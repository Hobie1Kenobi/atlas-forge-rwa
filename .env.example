# Public Sepolia rehearsal only. Never commit a real .env, keystore, or private key.
#
# Sign with a Foundry keystore. Do NOT use `--private-key` in commands or docs:
#   forge script script/Deploy.s.sol:Deploy --rpc-url "$SEPOLIA_RPC_URL" --account atlas-deployer --broadcast
#   forge script script/TestnetSmoke.s.sol:TestnetSmoke --rpc-url "$SEPOLIA_RPC_URL" --account atlas-deployer --broadcast
#
# TOKEN_NAME / TOKEN_SYMBOL are labels for the public testnet path:
# Atlas Forge Permissioned Test Token / AFPT.
# They are not a USD peg, reserve, redeem, KYC claim, or securities claim.
#
# If one keystore must hold multiple privileged roles because of faucet limits,
# set ACK_ROLE_OVERLAP=true. That is a rehearsal limitation, not production IAM.

ADMIN=
ISSUER=
FREEZER=
RECOVERY=
ALICE=
BOB=
CHARLIE=
UNAUTHORIZED=
TOKEN=
REGISTRY=
COMPLIANCE=
ACK_ROLE_OVERLAP=

TOKEN_NAME="Atlas Forge Permissioned Test Token"
TOKEN_SYMBOL=AFPT

SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
